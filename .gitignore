# Runtime / ephemera — never versioned (see Song-Vocabulary in the wiki).
# Performed-half live state:
song/stage/
song/auditions/
# Per-song scratch drafts (song/songbook/<song>/drafts/) — nested under the
# song they vary, never committed/declared truth (that's the whole point).
song/songbook/*/drafts/

# pi-subagents' runtime artifacts (parent-orchestrator runs):
.pi-subagents/

# pi's own runtime dir (conduct sessions):
.pi/

# Content-pipeline + audit runtime (repo root):
catalog/
index/
log
log/

# Account/usage runtime (repo root; disposable, never committed):
state/

# Deployed shell tree (rsynced from the store by home-manager; disposable):
run/

# Nix build outputs
result
result-*
