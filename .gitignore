# Runtime / ephemera — never versioned (rice state lives under $STRILLIX_ROOT).
# Performed-half live state (the rice stage and its auditions) is not in the checkout:
/stage/
/auditions/
# Declared-half live state (published by the quickshell activation seed):
/declared/
# Per-rice scratch drafts (rices/<rice>/drafts/) — nested under the rice they
# vary, never committed/declared truth (that's the whole point).
rices/*/drafts/
# Per-rice undo history (rices/<rice>/history/) — the machine's own, and
# `strillix rice declare` never copies it, so a hand-copied one stays untracked.
rices/*/history/

# pi-subagents' runtime artifacts (parent-orchestrator runs):
.pi-subagents/

# pi's own runtime dir (conduct sessions):
.pi/

# Obsidian per-user UI state — pane layout, open tabs, scroll positions.
# The vault's shared settings (app/appearance/core-plugins/graph) stay
# tracked; only this one rewrites itself on every session.
docs/Aoide-Wiki/.obsidian/workspace.json
docs/Aoide-Wiki/.obsidian/workspace-mobile.json

# Content-pipeline + audit runtime (repo root):
catalog/
index/
log
log/

# Account/usage runtime (repo root; disposable, never committed):
state/

# Deployed shell tree (rsynced from the store by home-manager; disposable):
run/

# Nix build outputs
result
result-*

# Obsidian editor state (workspace layout churns on every open):
docs/Aoide-Wiki/.obsidian/workspace.json

docs/Aoide-Wiki/.syncthing/

# Obsidian's own trash (a deleted wiki page lands here; git already has it)
docs/Aoide-Wiki/.trash/

# The docs/ and docs/architecture/ vaults follow the wiki's rule above:
# shared settings tracked, per-user pane layout ignored.
docs/.obsidian/workspace.json
docs/architecture/.obsidian/workspace.json

# Strillix preview/screenshot captures — regenerated by the suites that take them.
evidence/

# Leaked temp QML from the strillix dialog tests (named with pid + nanos).
pkgs/aoide/crates/strillix/aoide-dialog-qml-test-*.qml
