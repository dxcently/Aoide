# Generated by aoide-song (`rice stage`, `livery emit hyprlock`): the song's lock-screen dress.
# Variables only; a song with no lockscreen picture writes none. Never edit by hand.
$aoide_lock_color = rgb(1e1e2e)
$aoide_lock_image = /aoide/song/songbook/fixture/lockscreen.png
$aoide_lock_field_y = -26%
$aoide_lock_field_outer = rgb(89b4fa)
$aoide_lock_field_inner = rgb(1e1e2e)
$aoide_lock_field_font = rgb(cdd6f4)
$aoide_lock_field_check = rgb(89b4fa)
$aoide_lock_field_fail = rgb(f38ba8)
$aoide_lock_name_y = -21%
$aoide_lock_name_font = rgb(ffffff)
